# Kalshi API (required)
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=path/to/kalshi-key.key
# Or use PEM string instead: KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----..."

# API base URL (demo vs production)
KALSHI_BASE_URL=https://demo-api.kalshi.co

# Risk limits
KALSHI_MAX_EXPOSURE=100.0

# Strategy: fair_value | risk_neutral
KALSHI_STRATEGY=fair_value

# For fair_value: comma-separated tickers to trade
KALSHI_TICKERS=TICKER1,TICKER2

# Tuning (optional; defaults shown)
# KALSHI_HEARTBEAT_INTERVAL_SECONDS=60
# KALSHI_LOOP_INTERVAL_SECONDS=30
# KALSHI_ORDER_SIZE=1
# KALSHI_THRESHOLD_CENTS=2.0
# KALSHI_MIN_INVESTMENT_TO_HEDGE=10.0

# Optional: Discord webhook for alerts
# KALSHI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: Supabase (for risk_neutral position updates)
# KALSHI_SUPABASE_URL=https://xxx.supabase.co
# KALSHI_SUPABASE_KEY=your-anon-key
